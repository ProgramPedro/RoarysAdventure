{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "mac",
      "displayName": "Roary - macOS (Ninja + vcpkg)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/mac",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "windows-x64",
      "displayName": "Roary - Windows x64 (Visual Studio + bundled vcpkg)",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/build/windows-x64",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VSINSTALLDIR}/VC/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static"
      }
    }
  ],
  "buildPresets": [
    { "name": "mac", "configurePreset": "mac", "configuration": "Debug" },
    { "name": "windows-x64", "configurePreset": "windows-x64", "configuration": "Debug" }
  ]
}
